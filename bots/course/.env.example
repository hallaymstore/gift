# EduCourse Telegram Mini App
PORT=3000
NODE_ENV=production

# MongoDB
# Masalan: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/educourse_platform?retryWrites=true&w=majority
MONGODB_URI=PASTE_YOUR_MONGODB_URI_HERE

# Public URL: hostingdagi real HTTPS domen
PUBLIC_URL=https://your-domain.com
WEBAPP_URL=https://your-domain.com

# Telegram BotFather tokeni — aynan EduCourse/yangi bot tokenini kiriting
BOT_TOKEN=PASTE_NEW_EDUCOURSE_BOT_TOKEN_HERE
# Ixtiyoriy: xato token qo‘yilganini tez bilish uchun yangi bot username. @ belgisisiz yozing.
BOT_EXPECTED_USERNAME=PASTE_NEW_BOT_USERNAME_WITHOUT_AT

# Admin Telegram ID. Botga /id yuborib User ID ni oling.
ADMIN_TELEGRAM_CHAT_ID=6606638731
ADMIN_TELEGRAM_IDS=6606638731

REQUIRE_TELEGRAM_AUTH=false
INIT_DATA_MAX_AGE_SECONDS=86400

# Production webhook
AUTO_SET_WEBHOOK=true
TELEGRAM_POLLING=false
TELEGRAM_WEBHOOK_SECRET=

# Admin panel
ALLOW_PASSWORD_ADMIN=false
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
APP_SECRET=CHANGE_THIS_TO_LONG_RANDOM_SECRET_64_CHARS_MINIMUM

# Cloudinary
CLOUDINARY_CLOUD_NAME=PASTE_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=PASTE_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=PASTE_CLOUDINARY_API_SECRET
UPLOAD_MAX_MB=6

CORS_ORIGIN=*
